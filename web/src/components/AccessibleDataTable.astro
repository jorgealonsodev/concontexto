---
// design-system spec, "Eight components in a documented workbench" — the
// `accessible data table` entry, kept independently workbench-renderable per
// this slice's D4 resolution.
//
// web-accessibility-gates spec, "Every chart has an accessible data table":
// exposes period, value and provisional/definitive status for every rendered
// observation, reachable by assistive technology. The `id` prop is the stable
// anchor slice 7's `IndicatorChart.astro` uses to associate the chart with this
// table programmatically (e.g. `aria-describedby`) — that association is a
// chart-composition concern this component does not itself own.
//
// Tabular figures (PRD §12.1) on every value cell. Provisional rows carry the
// RESERVED dotted-grey encoding via the `provisional` token PLUS a dotted
// border pattern — never colour alone (design-system spec, "Colour is never
// the sole channel").
//
// VALUES ARE LOCALE-FORMATTED HERE, and that is a deliberate answer to a
// real question: this table is the accessible equivalent of the chart, so is
// it a reader surface or a data surface? It is a reader surface. A screen
// reader announcing "cuatro nueve seis ocho siete uno dos cero" is exactly
// the failure this table exists to prevent, whereas `49.687.120` is
// announced as a quantity. The machine-readable projection of the same
// observations already exists and is untouched: `ActionBar` links to the
// pipeline's own CSV and JSON, whose bytes this component never produces.
// The chart's own tooltip/point announcements are formatted the same way, so
// hearing a value and reading it give the same number.
//
// PERIODS ARE FORMATTED HERE TOO, in the COMPACT register, and the register
// is the whole decision. This column printed `2026-Q2` — the database's
// storage shape, with the English abbreviation for *quarter* — for every one
// of up to 294 rows. It is a COLUMN: at a 375 px viewport it shares the width
// with a value and a status, so "septiembre de 2026" would wrap and break the
// alignment the tabular figures beside it exist to create. "T2 2026" is
// exactly as wide as the label it replaces, and "sept 2026" is two glyphs
// wider — see `lib/format/period.ts` for the rule and for where the prose
// register applies instead.
import type { ObservationStatus } from "../lib/export/schema";
import { formatNumber } from "../lib/format/number";
import { formatPeriodCompact } from "../lib/format/period";
import { es } from "../i18n/es";

export interface AccessibleDataTablePoint {
  period: string;
  value: number | null;
  status: ObservationStatus;
}

export interface Props {
  id: string;
  caption: string;
  unit: string;
  decimals?: number;
  points: AccessibleDataTablePoint[];
}

const { id, caption, unit, decimals = 1, points } = Astro.props;
---

<table id={id} class="w-full border-collapse text-body text-ink" data-testid="accessible-data-table">
  <caption class="mb-2 text-left text-caption text-ink-muted">{caption} ({unit})</caption>
  <thead>
    <tr class="border-b border-ink/15">
      <th scope="col" class="px-2 py-1 text-left font-semibold">{es.table.periodHeader}</th>
      <th scope="col" class="px-2 py-1 text-right font-semibold">{es.table.valueHeader}</th>
      <th scope="col" class="px-2 py-1 text-left font-semibold">{es.table.statusHeader}</th>
    </tr>
  </thead>
  <tbody>
    {
      points.map((point) => (
        <tr class="border-b border-ink/10" data-status={point.status}>
          <td class="px-2 py-1">{formatPeriodCompact(point.period)}</td>
          <td
            class:list={[
              "font-numeric px-2 py-1 text-right tabular-nums",
              point.status === "P" && "border-b-2 border-dotted border-provisional text-provisional",
            ]}
            data-testid={`table-value-${point.status}`}
          >
            {point.value === null ? "—" : formatNumber(point.value, decimals)}
          </td>
          <td class="px-2 py-1">{es.chart.statusLabel[point.status]}</td>
        </tr>
      ))
    }
  </tbody>
</table>
