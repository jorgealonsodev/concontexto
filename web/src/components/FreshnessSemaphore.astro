---
// design-system spec, "Eight components in a documented workbench"; indicator-page
// spec, "The freshness semaphore has exactly two reader-facing states". Ships zero
// runtime JavaScript (design-system spec, "Seven components ship no runtime
// JavaScript").
//
// Exactly two states, both build-time facts derived from the export artifact's
// `freshness` field (`publishing.ArtifactFreshness`, "fresh" | "source-pending") —
// NEVER a third state comparing the page's own build time against the database
// (indicator-page spec: "The page MUST NOT display, compute, poll for or otherwise
// report whether the build is older than data held in the database" — that
// condition is an operations alert, `pipeline-operations`, never rendered here).
// This component's prop type therefore intentionally has no slot, variant or prop
// that could express that third condition — it cannot be constructed to say it.
//
// Colour is never the sole channel (PRD §12.5): the two states differ by icon
// shape (check vs. clock) AND by visible Spanish text, never by hue alone.
import type { ArtifactFreshness } from "../lib/export/schema";
import { es } from "../i18n/es";

export interface Props {
  state: ArtifactFreshness;
}

const { state } = Astro.props;

// Reader-facing Spanish copy, externalised in `es.freshness` (verify-report
// CRITICAL-3 remediation — moved out of this component verbatim).
// "Pendiente de actualización por la fuente" is spec-mandated verbatim
// (indicator-page spec, "A pending source period yields amber with its
// Spanish copy"). "Al día" is this session's own proposed label for the
// fresh state (the spec does not fix its exact wording) — flagged for
// editorial sign-off like every other new reader-facing string this slice
// introduces.
const LABEL: Record<ArtifactFreshness, string> = {
  fresh: es.freshness.fresh,
  "source-pending": es.freshness.sourcePending,
};

const label = LABEL[state];
---

{/*
  No translucent background: a `/10`-opacity fill blended over the page's own
  background measured BELOW 4.5:1 in a real browser (caught by this
  component's own Playwright contrast test — a real, browser-measured finding
  the pure token-pair harness could not have seen). Text renders directly on
  the page's real, fully opaque background, matching the already-verified
  "pending/fresh text on page background" pairing in
  `src/lib/design-system/contrast.ts`'s DECLARED_PAIRINGS. The border alone
  carries the full-opacity colour (a 3:1 UI-boundary contrast, not the 4.5:1
  text threshold).

  `self-start` is this component's own, and it belongs HERE rather than at
  each call site. `inline-flex` declares a pill sized to its own text, but
  cross-axis sizing is the one property a flex or grid PARENT decides for
  its child — and this component was dropped straight into a flex column at
  both of its real call sites (`IndicatorCard`'s root and the indicator
  page's header), where the default `align-items: stretch` widened the pill
  to the container's full width. Measured on the built page at 1280 px:
  848.0 px inside an 848.0 px header, and 238.0 px inside a 238.0 px card
  content box. A status stamp drawn as a full-width bordered box is
  indistinguishable from a button — on a `<span>` with no role, no
  tabindex and no handler, which does nothing when clicked. Patching one
  container would have left the other, and the next one.

  This is NOT the component reaching into its parent's layout. It is the
  component refusing to let a parent silently override the shape it
  declares: `align-self` is inert outside a flex/grid context, so in normal
  flow it costs exactly nothing. The alternative — a `class` prop callers
  pass layout through — would also reopen the escape hatch this component's
  header comment deliberately closes by keeping its prop surface at one
  value.

  Deliberately NOT `w-fit`: that would fix the width and leave the pill
  stretched to the container's HEIGHT in a flex row, which is the same
  defect on the other axis.
*/}
<span
  class:list={[
    "inline-flex self-start items-center gap-1.5 rounded-pill border px-2.5 py-1 text-caption font-medium",
    state === "fresh" && "border-fresh text-fresh",
    state === "source-pending" && "border-pending text-pending",
  ]}
  data-testid={`freshness-${state}`}
>
  {
    state === "fresh" ? (
      <svg aria-hidden="true" class="h-3.5 w-3.5 shrink-0" viewBox="0 0 16 16" fill="none">
        <path d="M3 8.5 6.5 12 13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    ) : (
      <svg aria-hidden="true" class="h-3.5 w-3.5 shrink-0" viewBox="0 0 16 16" fill="none">
        <circle cx="8" cy="8" r="6.25" stroke="currentColor" stroke-width="1.5" />
        <path d="M8 4.5V8l2.5 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )
  }
  <span>{label}</span>
</span>
