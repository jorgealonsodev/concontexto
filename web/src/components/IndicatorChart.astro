---
// design-system spec, "Eight components in a documented workbench" — the
// eighth entry, the chart itself. This is the STATIC half only (design.md
// D-5, D4 resolution/tasks.md slice 7 boundary): the complete no-JS
// experience — SVG, break bands, annotation groups, the accessible data
// table and the generated textual description — with zero runtime
// JavaScript of its own. `ChartIsland.svelte` (slice 8) progressively
// enhances this exact markup; it never replaces it.
//
// indicator-page spec, "Series breaks are always visible and never
// dismissible" (P4): break bands are rendered by `renderChartSVG` — the SAME
// shared function slice 8's island calls — so there is no separate JS-only
// band layer that could omit them with JavaScript disabled. The break LIST
// below the chart (one `BreakBand` per resolved break) carries the
// per-break hover/focus explanation; neither the SVG band nor the list item
// has any prop, attribute or control that hides it.
//
// "Three separately toggleable annotation groups, two off by default": (a)
// gobiernos and (b) shocks exógenos start OFF, (c) hitos normativos starts
// ON — all three use a native `<input type="checkbox">` + CSS
// `peer-checked:` disclosure, so the "visible enable control" the spec
// requires works with zero JavaScript (the browser's own label/checkbox
// association, not a script). A group with no applicable entries renders no
// control at all (absent, not disabled) — matches series-transformations
// spec's "a transformation/control that does not apply does not exist".
// Unconfirmed editorial entries never reach this component in the first
// place: `editorial-config` spec's "Unconfirmed editorial dates are
// operator-visible, never reader-visible" means an unconfirmed entry is
// never projected to the database, so it can never appear in the
// `annotations` prop — no extra filtering is needed here.
import AccessibleDataTable, { type AccessibleDataTablePoint } from "./AccessibleDataTable.astro";
import BreakBand from "./BreakBand.astro";
import AnnotationChip from "./AnnotationChip.astro";
import { describeSeries } from "../lib/chart/description";
import { narrowChartVariant, renderChartSVG } from "../lib/chart/svg";
import { periodFromCalendarDate, type Frequency } from "../lib/chart/periods";
import { formatPeriodProse } from "../lib/format/period";
import { es } from "../i18n/es";
import type { ObservationStatus } from "../lib/export/schema";

export interface IndicatorChartPoint {
  period: string;
  value: number | null;
  status: ObservationStatus;
}

export interface IndicatorChartBreak {
  key: string;
  date: string;
  kind: string;
  noteMd: string;
  sourceUrl?: string | null;
}

export type AnnotationGroup = "governments" | "exogenous" | "milestones";

export interface IndicatorChartAnnotation {
  id: string;
  group: AnnotationGroup;
  name: string;
  dateStart: string;
  dateEnd?: string | null;
  href?: string | null;
}

export interface Props {
  slug: string;
  name: string;
  unit: string;
  frequency: Frequency;
  points: IndicatorChartPoint[];
  breaks?: IndicatorChartBreak[];
  annotations?: IndicatorChartAnnotation[];
  decimals?: number;
  /** Disambiguates ids when more than one chart renders on one page (e.g.
   * this component's own light/dark workbench showcase) — same convention
   * `BreakBand`/`MethodologySheet` already use. */
  idSuffix?: string;
}

const {
  slug,
  name,
  unit,
  frequency,
  points,
  breaks = [],
  annotations = [],
  decimals = 1,
  idSuffix,
} = Astro.props;

const idBase = idSuffix ? `${slug}-${idSuffix}` : slug;
const titleId = `chart-title-${idBase}`;
// Its own id, not a shared one: both drawings carry a `<title>` referenced
// by `aria-labelledby`, and two nodes with one id is a duplicate in the
// document (axe `duplicate-id-aria`) even while CSS hides one of them.
const narrowTitleId = `chart-title-${idBase}-narrow`;
const descriptionId = `chart-description-${idBase}`;
const tableId = `chart-table-${idBase}`;

const description = describeSeries({ points, unit, decimals });

const chartInput = {
  points,
  breaks: breaks.map((b) => ({ key: b.key, date: b.date })),
  frequency,
  decimals,
  unit,
  descriptionId,
  tableId,
};

const svgMarkup = renderChartSVG({ ...chartInput, titleId });

// The SAME renderer, the same series, a different box — see
// `lib/chart/geometry.ts` for why a phone cannot read the wide one (at a
// 375 px viewport its tick labels land at 3.25 CSS px) and why the fix has
// to be geometry rather than type size. Both drawings reference the SAME
// description and data table: `aria-describedby` points at shared nodes,
// which is a reference, not a duplication.
const narrowSvgMarkup = renderChartSVG({
  ...chartInput,
  titleId: narrowTitleId,
  ...narrowChartVariant(points, decimals),
});

const tablePoints: AccessibleDataTablePoint[] = points.map((p) => ({
  period: p.period,
  value: p.value,
  status: p.status,
}));

function annotationDateLabel(ann: IndicatorChartAnnotation): string {
  const startYear = ann.dateStart.slice(0, 4);
  if (!ann.dateEnd) return startYear;
  const endYear = ann.dateEnd.slice(0, 4);
  return startYear === endYear ? startYear : `${startYear}–${endYear}`;
}

const GROUPS: AnnotationGroup[] = ["governments", "exogenous", "milestones"];
const DEFAULT_OPEN: Record<AnnotationGroup, boolean> = {
  governments: false,
  exogenous: false,
  milestones: true,
};
const groupedAnnotations = GROUPS.map((group) => ({
  group,
  label: es.chart.annotationGroupLabel[group],
  entries: annotations.filter((a) => a.group === group),
  defaultOpen: DEFAULT_OPEN[group],
})).filter((g) => g.entries.length > 0);

// The break's calendar date is snapped onto the series' own period axis
// (canonical — that is what the snap is defined on) and only then rendered,
// in the PROSE register: `BreakBand` puts it in a phrase ("Ruptura: T2 2021"),
// not in a column. `ChartIsland.svelte` derives the identical value the
// identical way, which is what `break-band-parity.test.ts` holds it to.
const breakDisplay = breaks.map((b) => ({
  ...b,
  displayPeriod: formatPeriodProse(periodFromCalendarDate(b.date, frequency)),
}));
---

<div class="indicator-chart" data-testid="indicator-chart" data-slug={slug}>
  {/*
    Two drawings, one shown. A static build cannot know the reader's
    viewport, so this uses the device `MethodologySheet.astro` already uses
    for exactly that problem: render both and let Tailwind's responsive
    utilities resolve it at the browser's own media-query evaluation, with
    zero JavaScript. The breakpoint is `md` — deliberately the SAME one the
    methodology sheet toggles on, so the site has one responsive boundary
    rather than two, and the same one `NARROW_VIEWPORT_QUERY` encodes for
    the island's interactive overlay.
  */}
  <div class="indicator-chart__figure indicator-chart__figure--narrow md:hidden">
    <Fragment set:html={narrowSvgMarkup} />
  </div>
  <div class="indicator-chart__figure indicator-chart__figure--wide hidden md:block">
    <Fragment set:html={svgMarkup} />
  </div>

  <p id={descriptionId} class="mt-3 text-body text-ink" data-testid="chart-description">
    {description}
  </p>

  <ul class="chart-legend mt-2 flex flex-wrap gap-4 text-caption text-ink-muted" data-testid="chart-legend">
    <li class="flex items-center gap-1.5">
      {/* The authored --radius-pill token via its own utility, never
          Tailwind's stock fully-rounded static utility (ADR-6: the project
          never consumes an unauthored Tailwind default when its own token
          achieves the identical visual result — deliberately not naming
          that stock class literally in this comment, since Tailwind's
          candidate scanner is a text heuristic that would otherwise treat
          the mention itself as usage — see theme.css's own header note). */}
      <span aria-hidden="true" class="inline-block h-2.5 w-2.5 rounded-pill bg-accent"></span>
      {es.chart.statusLabel.D}
    </li>
    <li class="flex items-center gap-1.5">
      <span aria-hidden="true" class="inline-block h-2.5 w-2.5 rotate-45 border border-dotted border-provisional bg-provisional"></span>
      {es.chart.statusLabel.P}
    </li>
  </ul>

  {
    breakDisplay.length > 0 && (
      <div class="chart-breaks mt-4" data-testid="chart-breaks">
        <h4 class="mb-2 text-caption font-semibold text-ink-muted">{es.chart.breaksHeading}</h4>
        <div class="flex flex-col gap-2">
          {breakDisplay.map((b) => (
            <BreakBand
              date={b.displayPeriod}
              kind={b.kind}
              summary={b.noteMd}
              noteHref={b.sourceUrl ?? `#ruptura-${b.key}`}
              id={`break-tooltip-${idBase}-${b.key}`}
            />
          ))}
        </div>
      </div>
    )
  }

  {
    groupedAnnotations.length > 0 && (
      <div class="chart-annotations mt-4 flex flex-col gap-3" data-testid="chart-annotations">
        {groupedAnnotations.map(({ group, label, entries, defaultOpen }) => {
          const toggleId = `ann-toggle-${idBase}-${group}`;
          const contentId = `ann-content-${idBase}-${group}`;
          return (
            <div class="annotation-group" data-testid={`annotation-group-${group}`}>
              <input
                type="checkbox"
                id={toggleId}
                class="peer sr-only"
                checked={defaultOpen}
                aria-controls={contentId}
              />
              <label
                for={toggleId}
                class="annotation-group__toggle inline-flex min-h-11 min-w-11 cursor-pointer items-center gap-2 rounded-control border border-ink/15 px-3 py-2 text-body text-ink hover:border-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                data-testid={`annotation-toggle-${group}`}
              >
                {/* No script exists to swap this text between "Mostrar"/
                    "Ocultar" as the checkbox's own checked state changes —
                    the native checkbox's OWN accessible state ("checkbox,
                    ..., not checked"/"checked") already communicates the
                    live state to assistive technology with zero JavaScript,
                    so the visible label is deliberately phrased to be
                    correct in EITHER state rather than asserting one. `es`
                    still exports the separate show/hide verbs for slice 8's
                    JS-enhanced island, which CAN update this text live. */}
                {es.chart.annotationToggleLabel(label)}
              </label>
              <div
                id={contentId}
                class="annotation-group__content mt-2 hidden flex-wrap gap-2 peer-checked:flex"
                data-testid={`annotation-group-content-${group}`}
              >
                {entries.map((entry) => (
                  <AnnotationChip
                    group={entry.group}
                    name={entry.name}
                    dateLabel={annotationDateLabel(entry)}
                    href={entry.href ?? null}
                  />
                ))}
              </div>
            </div>
          );
        })}
      </div>
    )
  }

  <div class="mt-4">
    <AccessibleDataTable
      id={tableId}
      caption={es.chart.tableCaption(name)}
      unit={unit}
      decimals={decimals}
      points={tablePoints}
    />
  </div>
</div>

<style>
  .indicator-chart__figure {
    width: 100%;
  }

  .indicator-chart-svg {
    width: 100%;
    height: auto;
  }

  /* Native CSS-only disclosure: no JavaScript required for the "visible
     enable control" the spec asks for (groups a/b off by default). The
     checkbox itself is visually hidden (`sr-only`) but remains in the
     accessibility tree and keyboard-operable; its own <label> IS the
     visible control. */
  .annotation-group__toggle-indicator {
    display: inline-block;
    width: 1em;
  }
</style>
