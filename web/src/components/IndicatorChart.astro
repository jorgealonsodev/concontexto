---
// design-system spec, "Eight components in a documented workbench" — the
// eighth entry, the chart itself. This is the STATIC half only (design.md
// D-5, D4 resolution/tasks.md slice 7 boundary): the complete no-JS
// experience — SVG, break bands, annotation groups, the accessible data
// table and the generated textual description — with zero runtime
// JavaScript of its own. `ChartIsland.svelte` (slice 8) progressively
// enhances this exact markup; it never replaces it.
//
// indicator-page spec, "Series breaks are always visible and never
// dismissible" (P4): break bands are rendered by `renderChartSVG` — the SAME
// shared function slice 8's island calls — so there is no separate JS-only
// band layer that could omit them with JavaScript disabled. The break LIST
// below the chart (one `BreakBand` per resolved break) carries the
// per-break hover/focus explanation; neither the SVG band nor the list item
// has any prop, attribute or control that hides it.
//
// "Three separately toggleable annotation groups, two off by default": (a)
// gobiernos and (b) shocks exógenos start OFF, (c) hitos normativos starts
// ON — all three use a native `<input type="checkbox">` + CSS
// `peer-checked:` disclosure, so the "visible enable control" the spec
// requires works with zero JavaScript (the browser's own label/checkbox
// association, not a script). A group with no applicable entries renders no
// control at all (absent, not disabled) — matches series-transformations
// spec's "a transformation/control that does not apply does not exist".
// Unconfirmed editorial entries never reach this component in the first
// place: `editorial-config` spec's "Unconfirmed editorial dates are
// operator-visible, never reader-visible" means an unconfirmed entry is
// never projected to the database, so it can never appear in the
// `annotations` prop — no extra filtering is needed here.
import AccessibleDataTable, { type AccessibleDataTablePoint } from "./AccessibleDataTable.astro";
import BreakBand from "./BreakBand.astro";
import AnnotationChip from "./AnnotationChip.astro";
import {
  describeEventSpans,
  describeGovernmentChanges,
  describePolicyMeasures,
  describeSeries,
} from "../lib/chart/description";
import { selectEventSpans } from "../lib/chart/eventSpans";
import { selectGovernmentChanges } from "../lib/chart/governmentMarkers";
import { selectPolicyMeasures } from "../lib/chart/measureMarks";
import { narrowChartVariant, renderChartSVG } from "../lib/chart/svg";
import { periodFromCalendarDate, type Frequency } from "../lib/chart/periods";
import { formatPeriodProse } from "../lib/format/period";
import { es } from "../i18n/es";
import type { ObservationStatus } from "../lib/export/schema";

export interface IndicatorChartPoint {
  period: string;
  value: number | null;
  status: ObservationStatus;
}

export interface IndicatorChartBreak {
  key: string;
  date: string;
  kind: string;
  noteMd: string;
  sourceUrl?: string | null;
}

export type AnnotationGroup = "governments" | "exogenous" | "milestones" | "measures";

export interface IndicatorChartAnnotation {
  id: string;
  group: AnnotationGroup;
  name: string;
  dateStart: string;
  dateEnd?: string | null;
  /** Where the chip links, when the registry recorded a document to link to.
   * For a policy measure this is its BOE citation, required by
   * validate-config: the whole content of the annotation is a date, and a
   * date a reader cannot check against the primary source is an editorial
   * assertion rather than a fact. */
  href?: string | null;
}

export interface Props {
  slug: string;
  name: string;
  unit: string;
  frequency: Frequency;
  points: IndicatorChartPoint[];
  breaks?: IndicatorChartBreak[];
  annotations?: IndicatorChartAnnotation[];
  decimals?: number;
  /** Disambiguates ids when more than one chart renders on one page (e.g.
   * this component's own light/dark workbench showcase) — same convention
   * `BreakBand`/`MethodologySheet` already use. */
  idSuffix?: string;
}

const {
  slug,
  name,
  unit,
  frequency,
  points,
  breaks = [],
  annotations = [],
  decimals = 1,
  idSuffix,
} = Astro.props;

const idBase = idSuffix ? `${slug}-${idSuffix}` : slug;
const titleId = `chart-title-${idBase}`;
// Its own id, not a shared one: both drawings carry a `<title>` referenced
// by `aria-labelledby`, and two nodes with one id is a duplicate in the
// document (axe `duplicate-id-aria`) even while CSS hides one of them.
const narrowTitleId = `chart-title-${idBase}-narrow`;
const descriptionId = `chart-description-${idBase}`;
const tableId = `chart-table-${idBase}`;

const description = describeSeries({ points, unit, decimals });

const GROUPS: AnnotationGroup[] = ["governments", "exogenous", "milestones", "measures"];
// `measures` opens BY DEFAULT, joining `milestones`, and the reason is the
// product requirement itself: the owner asked to see, on each chart, which
// policy measures were taken and when. A layer the reader has to discover
// behind a closed toggle does not answer that.
//
// What makes opening it by default safe is the same thing that makes the
// layer safe at all -- the mark is a stub in the axis gutter that touches no
// value, and the sentence rendered beside it closes by stating that the chart
// represents no relation between those measures and the series. It is also,
// unlike the three transversal groups, SCOPED: only measures whose registry
// scope covers this series ever reach this component, so opening it adds
// nothing to a chart the measure was not addressed at.
const DEFAULT_OPEN: Record<AnnotationGroup, boolean> = {
  governments: false,
  exogenous: false,
  milestones: true,
  measures: true,
};

// The annotation entries this drawing may project, over the groups that are
// open BY DEFAULT — the exact same map `ChartIsland.svelte` initialises its own
// toggle state from, which is what keeps this component's drawing
// byte-identical to the island's server-rendered one
// (`test/chart/island-ssr.test.ts`'s golden parity).
//
// BOTH annotation layers read it, and that is the change: the
// change-of-government markers used to be drawn unconditionally, so a reader
// who had never opened "gobiernos" still got its rules across their chart. They
// are now gated on the same selection the rails have always answered — nothing
// is drawn unless it is selected — and `governments` is one of the two groups
// that start closed, so this component's default drawing carries none.
//
// STATED PLAINLY, because it is a real limitation and not an oversight: the
// CSS-only checkbox below reveals and hides this component's annotation CHIPS
// with zero JavaScript, and it cannot redraw an SVG that was serialised to a
// string at build time. So in this component — the workbench's static catalog
// entry, never a reader route — the drawing shows the default-open groups and
// stays there. The reader route is `/indicador/{slug}`, which composes the
// island; there the same toggle re-selects both layers, redraws them and
// re-narrates their sentences. This component's job is the no-JS BASELINE, and
// the baseline it renders is exactly what a no-JS reader of a real page gets.
const shownAnnotations = annotations.filter((a) => DEFAULT_OPEN[a.group]);

// The changes of government this drawing may honestly mark. The SAME list feeds
// the drawing and the sentence beside it, so the rules a sighted reader counts
// and the names a screen-reader reader hears can never disagree — and neither
// can be produced without the other.
const governmentChanges = selectGovernmentChanges(shownAnnotations, points.map((p) => p.period), frequency);
const governmentNote = describeGovernmentChanges(governmentChanges);

const eventSpans = selectEventSpans(shownAnnotations, points.map((p) => p.period), frequency);
const eventSpanNote = describeEventSpans(eventSpans);

// The same discipline one layer over: ONE list feeds the marks and the
// sentence, so the stubs a sighted reader counts and the instruments a
// screen-reader reader hears can never disagree.
const policyMeasures = selectPolicyMeasures(shownAnnotations, points.map((p) => p.period), frequency);
const policyMeasureNote = describePolicyMeasures(policyMeasures);

const chartInput = {
  points,
  breaks: breaks.map((b) => ({ key: b.key, date: b.date })),
  // Both filtered, and only by group visibility — see above. Which of the
  // entries handed in may honestly be marked, and where each label can be
  // drawn, stays `renderChartSVG`'s single decision, made inside the renderer
  // this component and the island share.
  governmentChanges: shownAnnotations,
  eventSpans: shownAnnotations,
  policyMeasures: shownAnnotations,
  frequency,
  decimals,
  unit,
  descriptionId,
  tableId,
};

const svgMarkup = renderChartSVG({ ...chartInput, titleId });

// The SAME renderer, the same series, a different box — see
// `lib/chart/geometry.ts` for why a phone cannot read the wide one (at a
// 375 px viewport its tick labels land at 3.25 CSS px) and why the fix has
// to be geometry rather than type size. Both drawings reference the SAME
// description and data table: `aria-describedby` points at shared nodes,
// which is a reference, not a duplication.
const narrowSvgMarkup = renderChartSVG({
  ...chartInput,
  titleId: narrowTitleId,
  ...narrowChartVariant(points, decimals),
});

const tablePoints: AccessibleDataTablePoint[] = points.map((p) => ({
  period: p.period,
  value: p.value,
  status: p.status,
}));

function annotationDateLabel(ann: IndicatorChartAnnotation): string {
  const startYear = ann.dateStart.slice(0, 4);
  if (!ann.dateEnd) return startYear;
  const endYear = ann.dateEnd.slice(0, 4);
  return startYear === endYear ? startYear : `${startYear}–${endYear}`;
}

const groupedAnnotations = GROUPS.map((group) => ({
  group,
  label: es.chart.annotationGroupLabel[group],
  entries: annotations.filter((a) => a.group === group),
  defaultOpen: DEFAULT_OPEN[group],
})).filter((g) => g.entries.length > 0);

// The break's calendar date is snapped onto the series' own period axis
// (canonical — that is what the snap is defined on) and only then rendered,
// in the PROSE register: `BreakBand` puts it in a phrase ("Ruptura: T2 2021"),
// not in a column. `ChartIsland.svelte` derives the identical value the
// identical way, which is what `break-band-parity.test.ts` holds it to.
const breakDisplay = breaks.map((b) => ({
  ...b,
  displayPeriod: formatPeriodProse(periodFromCalendarDate(b.date, frequency)),
}));
---

<div class="indicator-chart" data-testid="indicator-chart" data-slug={slug}>
  {/*
    Two drawings, one shown. A static build cannot know the reader's
    viewport, so this uses the device `MethodologySheet.astro` already uses
    for exactly that problem: render both and let Tailwind's responsive
    utilities resolve it at the browser's own media-query evaluation, with
    zero JavaScript. The breakpoint is `md` — deliberately the SAME one the
    methodology sheet toggles on, so the site has one responsive boundary
    rather than two, and the same one `NARROW_VIEWPORT_QUERY` encodes for
    the island's interactive overlay.
  */}
  <div class="indicator-chart__figure indicator-chart__figure--narrow md:hidden">
    <Fragment set:html={narrowSvgMarkup} />
  </div>
  <div class="indicator-chart__figure indicator-chart__figure--wide hidden md:block">
    <Fragment set:html={svgMarkup} />
  </div>

  {/*
    The series' own pattern, and nothing else. The change-of-government
    sentence used to be appended here; it moved to the live region below when
    the markers became selection-gated — see `ChartIsland.svelte`'s own copy of
    this markup for the full reasoning, which this component mirrors.
  */}
  <p id={descriptionId} class="mt-3 text-body text-ink" data-testid="chart-description">
    {description}
  </p>

  {/*
    The change-of-government sentence. It is the only route a screen-reader
    reader has to the marker layer (the drawing is a single `role="img"`, which
    prunes its own children), and it is also what keeps a label the drawing
    could not fit from vanishing silently — a name that cannot be drawn whole
    and inside the plot area is refused rather than truncated, and this sentence
    still carries it. `aria-live` here purely so this component's markup stays a
    faithful catalog of the island's; nothing on a static page can change it.
  */}
  <p class="mt-1 text-caption text-ink-muted" aria-live="polite" data-testid="chart-government-note">
    {governmentNote}
  </p>

  {/*
    The event-span sentence — the visible legend naming which events the rails
    bound, and the only route a screen-reader reader has to them (the drawing
    is a single `role="img"`, which prunes its own children). It carries
    `aria-live` here purely so this component's markup stays a faithful catalog
    of the island's; nothing on a static page can change it.
  */}
  <p class="mt-1 text-caption text-ink-muted" aria-live="polite" data-testid="chart-event-spans-note">
    {eventSpanNote}
  </p>

  {/*
    The policy-measure sentence — the only place a reader learns WHICH
    instruments the gutter stubs stand for, since a measure carries no
    on-drawing label (see `svg.ts` for why the gutter has no room for one).
    It closes by stating that the chart represents no relation between those
    measures and the series: the drawing already refuses to imply one by
    staying out of the plot area, and this says so in words for the reader who
    only hears the page. `aria-live` here purely so this component's markup
    stays a faithful catalog of the island's; nothing on a static page can
    change it.
  */}
  <p class="mt-1 text-caption text-ink-muted" aria-live="polite" data-testid="chart-measures-note">
    {policyMeasureNote}
  </p>

  <ul class="chart-legend mt-2 flex flex-wrap gap-4 text-caption text-ink-muted" data-testid="chart-legend">
    <li class="flex items-center gap-1.5">
      {/* The authored --radius-pill token via its own utility, never
          Tailwind's stock fully-rounded static utility (ADR-6: the project
          never consumes an unauthored Tailwind default when its own token
          achieves the identical visual result — deliberately not naming
          that stock class literally in this comment, since Tailwind's
          candidate scanner is a text heuristic that would otherwise treat
          the mention itself as usage — see theme.css's own header note). */}
      <span aria-hidden="true" class="inline-block h-2.5 w-2.5 rounded-pill bg-accent"></span>
      {es.chart.statusLabel.D}
    </li>
    <li class="flex items-center gap-1.5">
      <span aria-hidden="true" class="inline-block h-2.5 w-2.5 rotate-45 border border-dotted border-provisional bg-provisional"></span>
      {es.chart.statusLabel.P}
    </li>
    {
      /* The third entry teaches the third code. Without it a vertical rule is
         a decoration a reader has to guess at; with it, it is a mark with a
         meaning. Present only when the drawing really carries a marker — a
         legend entry for something not on screen is the "control that does not
         apply" the spec asks to be absent rather than shown.
         The glyph is the marker itself in miniature (triangular flag on a
         solid rule), so the legend and the drawing are the same object at two
         sizes — never a swatch that merely shares a colour. */
      governmentChanges.length > 0 && (
        <li class="flex items-center gap-1.5" data-testid="chart-legend-government">
          <svg aria-hidden="true" viewBox="0 0 10 14" class="h-3.5 w-2.5 shrink-0 text-ink" fill="none">
            <path d="M0 0 L10 0 L5 4 Z" fill="currentColor" />
            <line x1="5" y1="0" x2="5" y2="14" stroke="currentColor" stroke-width="1" />
          </svg>
          {es.chart.government.markerLegendLabel}
        </li>
      )
    }
    {
      /* The fifth entry, on the same terms as the third and fourth: present
         only while the drawing really carries a mark, and carrying the mark's
         own glyph in miniature rather than a swatch. What the legend shows
         first is the property that separates this mark from the government
         rule above — it hangs BELOW the axis line and does not touch it,
         where that one stands on the plot and runs its full height. */
      policyMeasures.length > 0 && (
        <li class="flex items-center gap-1.5" data-testid="chart-legend-measure">
          <svg aria-hidden="true" viewBox="0 0 10 12" class="h-3 w-2.5 shrink-0" fill="none">
            <line x1="0" y1="3" x2="10" y2="3" stroke="currentColor" stroke-width="1" class="text-ink-muted" />
            <line x1="5" y1="6" x2="5" y2="12" stroke="currentColor" stroke-width="2" class="text-event-span" />
          </svg>
          {es.chart.measure.legendLabel}
        </li>
      )
    }
    {
      /* The fourth entry, on the same terms as the third: present only while
         the drawing really carries a rail, and carrying the rail's own glyph
         in miniature rather than a swatch. The ORIENTATION that separates this
         mark from the government marker above — horizontal against vertical —
         is what the legend shows first. */
      eventSpans.length > 0 && (
        <li class="flex items-center gap-1.5" data-testid="chart-legend-event-span">
          <svg aria-hidden="true" viewBox="0 0 16 8" class="h-2 w-4 shrink-0 text-event-span" fill="none">
            <path d="M1 7 L1 2 L15 2 L15 7" stroke="currentColor" stroke-width="1.5" />
          </svg>
          {es.chart.eventSpan.legendLabel}
        </li>
      )
    }
  </ul>

  {
    breakDisplay.length > 0 && (
      <div class="chart-breaks mt-4" data-testid="chart-breaks">
        <h4 class="mb-2 text-caption font-semibold text-ink-muted">{es.chart.breaksHeading}</h4>
        <div class="flex flex-col gap-2">
          {breakDisplay.map((b) => (
            <BreakBand
              date={b.displayPeriod}
              kind={b.kind}
              summary={b.noteMd}
              noteHref={b.sourceUrl ?? `#ruptura-${b.key}`}
              id={`break-tooltip-${idBase}-${b.key}`}
            />
          ))}
        </div>
      </div>
    )
  }

  {
    groupedAnnotations.length > 0 && (
      <div class="chart-annotations mt-4 flex flex-col gap-3" data-testid="chart-annotations">
        {groupedAnnotations.map(({ group, label, entries, defaultOpen }) => {
          const toggleId = `ann-toggle-${idBase}-${group}`;
          const contentId = `ann-content-${idBase}-${group}`;
          return (
            <div class="annotation-group" data-testid={`annotation-group-${group}`}>
              <input
                type="checkbox"
                id={toggleId}
                class="peer sr-only"
                checked={defaultOpen}
                aria-controls={contentId}
              />
              <label
                for={toggleId}
                class="annotation-group__toggle inline-flex min-h-11 min-w-11 cursor-pointer items-center gap-2 rounded-control border border-ink/15 px-3 py-2 text-body text-ink hover:border-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                data-testid={`annotation-toggle-${group}`}
              >
                {/* No script exists to swap this text between "Mostrar"/
                    "Ocultar" as the checkbox's own checked state changes —
                    the native checkbox's OWN accessible state ("checkbox,
                    ..., not checked"/"checked") already communicates the
                    live state to assistive technology with zero JavaScript,
                    so the visible label is deliberately phrased to be
                    correct in EITHER state rather than asserting one. `es`
                    still exports the separate show/hide verbs for slice 8's
                    JS-enhanced island, which CAN update this text live. */}
                {es.chart.annotationToggleLabel(label)}
              </label>
              <div
                id={contentId}
                class="annotation-group__content mt-2 hidden flex-wrap gap-2 peer-checked:flex"
                data-testid={`annotation-group-content-${group}`}
              >
                {entries.map((entry) => (
                  <AnnotationChip
                    group={entry.group}
                    name={entry.name}
                    dateLabel={annotationDateLabel(entry)}
                    href={entry.href ?? null}
                  />
                ))}
              </div>
            </div>
          );
        })}
      </div>
    )
  }

  <div class="mt-4">
    <AccessibleDataTable
      id={tableId}
      caption={es.chart.tableCaption(name)}
      unit={unit}
      decimals={decimals}
      points={tablePoints}
    />
  </div>
</div>

<style>
  .indicator-chart__figure {
    width: 100%;
  }

  .indicator-chart-svg {
    width: 100%;
    height: auto;
  }

  /* Native CSS-only disclosure: no JavaScript required for the "visible
     enable control" the spec asks for (groups a/b off by default). The
     checkbox itself is visually hidden (`sr-only`) but remains in the
     accessibility tree and keyboard-operable; its own <label> IS the
     visible control. */
  .annotation-group__toggle-indicator {
    display: inline-block;
    width: 1em;
  }
</style>
