---
// indicator-page spec, "Page anatomy per PRD §6.1.1": composes every
// section a real indicator page must render, in order — header, chart,
// action bar, methodology sheet, related indicators — from already-resolved
// props. Deliberately extracted from `src/pages/indicador/[slug].astro` so
// this component is directly testable via `experimental_AstroContainer`
// (this project's established convention, e.g. `IndicatorChart.astro`)
// WITHOUT going through `getStaticPaths`/the loader — the thin route file
// owns build-time artifact loading and slug enumeration; this component
// owns rendering.
//
// Deliberately placed under `src/templates/`, NOT `src/components/`: it is
// a PAGE composition template, not one of the design-system spec's eight
// catalog components, and several slice 5/6 tests scan `src/components/`
// wholesale (the zero-runtime-JS structural guard, the reserved-semantics
// exclusivity guard) under the accurate assumption — true until this file
// existed — that every `.astro` file there IS one of those eight. Keeping
// this file in its own directory avoids retrofitting those slice 5/6
// guards to special-case a ninth, structurally different file.
//
// "Data and interpretation are structurally separate" (P1): the header
// below renders ONLY the indicator name, latest value, its period, both
// variation figures and the freshness semaphore — no free prose. All
// interpretive/editorial text (what the series measures, page-state
// banners) lives in its own labelled region, never inside the header.
//
// "The chart MUST NOT be hidden in any state" (PRD §6.1.3): the chart
// island below is composed unconditionally, regardless of `pageState` —
// there is no conditional branch anywhere in this file that could omit it.
import ChartIsland from "../components/ChartIsland.svelte";
import FreshnessSemaphore from "../components/FreshnessSemaphore.astro";
import ActionBar from "../components/ActionBar.astro";
import MethodologySheet from "../components/MethodologySheet.astro";
import IndicatorCard from "../components/IndicatorCard.astro";
import type { SeriesDoc, SeriesPoint, ArtifactFreshness } from "../lib/export/schema";
import type { IndicatorContentConfig } from "../content/indicators/types";
import type { MethodologyContent } from "../content/indicators/methodology";
import { pageStateBannerCopy, pageStateFromArtifact } from "../lib/indicator/pageState";
import { INDICATOR_CONTENT, routeSlugForArtifactSlug } from "../content/indicators";
import { computeYoY, computeIntraPeriodRate } from "../lib/transform/yoy";
import { periodFromCalendarDate } from "../lib/chart/periods";
import { es } from "../i18n/es";

export interface RelatedCardData {
  slug: string;
  name: string;
  unit: string;
  latestValue: number | null;
  latestPeriod: string;
  freshness: ArtifactFreshness;
  decimals?: number;
}

export interface Props {
  doc: SeriesDoc;
  content: IndicatorContentConfig;
  methodology: MethodologyContent;
  relatedCards: RelatedCardData[];
  /** Population observations, supplied only when `content.transforms.perCapita`
   * is true (the SAME artifact's `poblacion-residente` doc, resolved by the
   * caller — every in-scope per-capita series this slice ships pages for
   * has population data in the SAME loaded artifact). */
  population?: SeriesPoint[];
  canonicalPath: string;
}

const { doc, content, methodology, relatedCards, population = [], canonicalPath } = Astro.props;

const latest = doc.points[doc.points.length - 1] ?? null;

const yoySeries = computeYoY(doc.points, doc.frequency);
const qoqSeries = computeIntraPeriodRate(doc.points, doc.frequency);
const yoyAtLatest = latest ? yoySeries.find((p) => p.period === latest.period) ?? null : null;
const qoqAtLatest = latest ? qoqSeries.find((p) => p.period === latest.period) ?? null : null;

function formatVariation(rate: { value: number } | null): string {
  if (!rate) return es.page.variationNotAvailable;
  const sign = rate.value >= 0 ? "+" : "";
  return `${sign}${rate.value.toFixed(1)}%`;
}

// verify-report CRITICAL-4: the page state comes from the ARTIFACT, never
// from `methodology` (which used to hard-code `{ kind: "fresh" }` for all
// six series, so no real validation failure could ever surface without a
// source edit and a redeploy).
const pageState = pageStateFromArtifact(doc.pageState);
const bannerCopy = pageStateBannerCopy(pageState);
const isDiscontinued = pageState.kind === "discontinued";
// The artifact records a SERIES slug; a link needs the frozen ROUTE slug,
// and the two diverge for `pib`/`pib-cvi`. An unresolvable successor renders
// the banner with NO link rather than an href that 404s — the spec asks for
// "a successor link ... when a successor is configured", and a link to a
// page that does not exist is not one.
const successorRouteSlug = isDiscontinued && pageState.successorSlug !== null
  ? routeSlugForArtifactSlug(pageState.successorSlug)
  : null;
// The link names the successor the way a reader knows it. A resolved route
// slug always has a content entry (that is how it was resolved), so the
// fallback is unreachable defensive code rather than a silent slug leak.
const successorName = successorRouteSlug ? INDICATOR_CONTENT[successorRouteSlug]?.name ?? successorRouteSlug : null;

const breakDisplay = doc.breaks.map((b) => ({
  date: periodFromCalendarDate(b.date, doc.frequency),
  note: b.noteMd,
}));

const maxVersion = doc.points.reduce((max, p) => Math.max(max, p.version), 0);

const perCapitaAttribution = content.transforms.perCapita ? es.chart.perCapita.attributionRule : null;
---

{
  /* `data-slug` and `ChartIsland`'s `slug` prop below intentionally use
     `content.slug` (the frozen ROUTE slug), not `doc.slug` (the artifact's
     own slug) -- they coincide for five of six series, but `pib`'s artifact
     document is slugged `pib-cvi` (see `[slug].astro`'s own doc comment).
     `doc.slug` itself is still used for `ActionBar`'s CSV/JSON hrefs below,
     since THOSE must resolve to the real published filenames. */
}
<article data-testid="indicator-page" data-slug={content.slug}>
  {
    bannerCopy && (
      <div
        role="status"
        data-testid={isDiscontinued ? "page-banner-discontinued" : "page-banner-validation-failure"}
        class="mb-4 rounded-card border-2 border-ink/20 bg-surface p-3 text-body text-ink"
      >
        <p>{bannerCopy}</p>
        {isDiscontinued && successorRouteSlug && (
          <p>
            <a
              href={`/indicador/${successorRouteSlug}`}
              data-testid="page-banner-successor-link"
              class="underline"
            >
              {es.page.discontinuedSuccessorLink(successorName ?? successorRouteSlug)}
            </a>
          </p>
        )}
      </div>
    )
  }

  <header data-testid="page-header" class="mb-4 flex flex-col gap-2">
    <h1 class="text-heading-lg font-semibold text-ink" data-testid="page-title">{content.name}</h1>
    <div class="flex flex-wrap items-baseline gap-3">
      <span class="font-numeric text-heading-md tabular-nums text-ink" data-testid="page-latest-value">
        {latest && latest.value !== null ? latest.value.toFixed(content.decimals) : "—"}
        <span class="text-body text-ink-muted">{content.unit}</span>
      </span>
      <span class="text-caption text-ink-muted" data-testid="page-latest-period">
        {es.page.latestPeriodLabel}: {latest?.period ?? "—"}
      </span>
    </div>
    <dl class="flex flex-wrap gap-4 text-caption text-ink-muted">
      <div>
        <dt class="inline">{es.chart.transforms.yoy}: </dt>
        <dd class="font-numeric inline tabular-nums" data-testid="page-yoy-variation">{formatVariation(yoyAtLatest)}</dd>
      </div>
      <div>
        <dt class="inline">{es.chart.transforms.qoq(doc.frequency)}: </dt>
        <dd class="font-numeric inline tabular-nums" data-testid="page-intra-annual-variation">{formatVariation(qoqAtLatest)}</dd>
      </div>
    </dl>
    <FreshnessSemaphore state={doc.freshness} />
  </header>

  <section data-testid="page-chart-section" aria-label={content.name}>
    <ChartIsland
      client:idle
      slug={content.slug}
      name={content.name}
      unit={doc.unit}
      frequency={doc.frequency}
      decimals={content.decimals}
      points={doc.points}
      breaks={doc.breaks.map((b) => ({ key: b.key, date: b.date, kind: b.kind, noteMd: b.noteMd, sourceUrl: b.sourceUrl ?? null }))}
      annotations={doc.events.map((e) => ({
        id: e.id,
        // No cast: `SeriesDocSchema` types `event.group` as the same three-way
        // union `ChartIsland` accepts (verify-report BLOCKING-1). It used to
        // read `e.group as "governments" | "exogenous" | "milestones"` — an
        // assertion the compiler could not check, over a value that was
        // `unknown` anyway.
        group: e.group,
        name: e.name,
        dateStart: e.dateStart,
        dateEnd: e.dateEnd ?? null,
        href: null,
      }))}
      transforms={content.transforms}
      population={population}
      breaksHeadingLevel={2}
    />
  </section>

  <ActionBar
    permalink={canonicalPath}
    csvHref={`/data-derived/csv/${doc.slug}.csv`}
    jsonHref={`/data-derived/series/${doc.slug}.json`}
  />

  {
    /* `slug` below is the ROUTE slug, like `data-slug` and the island's own
       `slug` above -- this prop becomes a DOM id (`methodology-heading-<slug>`,
       the target of the section's `aria-labelledby`), so it must live in the
       same identifier space as every other id on the page. Passing `doc.slug`
       rendered `methodology-heading-pib-cvi` on `/indicador/pib`
       (verify-report SUGGESTION-13): internally consistent, but built from the
       pipeline's series slug rather than the route's.

       `routeSlugForArtifactSlug()` is deliberately NOT used here. That helper
       exists for artifact-supplied slugs with no other provenance (the
       discontinued successor above), and it can return null -- which would
       force this call site to invent a fallback for a value it already holds
       with certainty as a prop.

       `doc.slug` is still the right one for `ActionBar`'s two hrefs just
       above, which must name real published FILES. */
  }
  <MethodologySheet
    slug={content.slug}
    measures={methodology.measures}
    doesNotMeasure={methodology.doesNotMeasure}
    sourceName={doc.source.name}
    sourceUrl={doc.source.licenceUrl}
    operation={doc.operation}
    originLabel={doc.origin.ref}
    originHref={doc.origin.requestUrl}
    periodicity={es.page.periodicityLabel[doc.frequency]}
    nextPublicationLabel={`${es.page.nextPublicationFallback} (${methodology.nextPublicationHref})`}
    extractedAt={doc.vintage.extractedAt}
    unit={doc.unit}
    base={doc.base}
    breaks={breakDisplay}
    vintageLabel={`Versión ${maxVersion}`}
    revisionHistoryHref={`${canonicalPath}#vintage`}
    ingestionScriptHref={methodology.ingestionScriptHref}
    perCapitaAttribution={perCapitaAttribution}
  />

  <section data-testid="related-indicators" aria-labelledby="related-indicators-heading" class="mt-6">
    <h2 id="related-indicators-heading" class="mb-3 text-heading-sm font-semibold text-ink">{es.page.relatedHeading}</h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        relatedCards.map((card) => (
          <IndicatorCard
            slug={card.slug}
            name={card.name}
            unit={card.unit}
            latestValue={card.latestValue}
            latestPeriod={card.latestPeriod}
            freshness={card.freshness}
            decimals={card.decimals}
          />
        ))
      }
    </div>
  </section>
</article>
